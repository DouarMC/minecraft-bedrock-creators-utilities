{
    "name": "minecraft-bedrock-creators-utilities",
    "displayName": "minecraft-bedrock-creators-utilities",
    "description": "VS Code tools for Minecraft Bedrock add-on development",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "minecraft-bedrock-creators-utilities.initProject",
                "title": "Initialiser un projet Minecraft Bedrock",
                "category": "Minecraft Bedrock Utilities"
            },
            {
                "command": "minecraft-bedrock-creators-utilities.deployProject",
                "title": "Déployer le projet Minecraft Bedrock courant",
                "category": "Minecraft Bedrock Utilities"
            },
            {
                "command": "minecraft-bedrock-creators-utilities.toggleWatchDeploy",
                "title": "Activer/Désactiver le déploiement automatique du projet Minecraft Bedrock",
                "category": "Minecraft Bedrock Utilities"
            },
            {
                "command": "minecraft-bedrock-creators-utilities.openMolangEditor",
                "title": "Ouvrir l'éditeur Molang",
                "category": "Minecraft Bedrock Utilities"
            },
            {
                "command": "minecraft-bedrock-creators-utilities.exploreMinecraftFolders",
                "title": "Ouvrir les dossiers Minecraft Bedrock",
                "category": "Minecraft Bedrock Utilities"
            },
            {
                "command": "minecraft-bedrock-creators-utilities.exportProject",
                "title": "Exporter le projet Minecraft Bedrock courant",
                "category": "Minecraft Bedrock Utilities"
            },
            {
                "command": "minecraft-bedrock-creators-utilities.addScriptApi",
                "title": "Ajouter l'API de script au projet Minecraft Bedrock courant",
                "category": "Minecraft Bedrock Utilities"
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": [
                    "**/behavior_pack/**/*.json",
                    "**/resource_pack/**/*.json",
                    "**/addon/**/*.json"
                ],
                "url": "./assets/schemas/empty.schema.json"
            },
            {
                "fileMatch": "**/.mcbe_project.json",
                "url": "./assets/schemas/mcbe_project.schema.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/DouarMC/minecraft-bedrock-creators-utilities.git"
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test",
        "build-schemas": "tsx scripts/buildSchemas.ts",
        "include-vanilla-identifier-to-json": "tsx scripts/includeVanillaIdentifierToJson.ts"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.20",
        "@types/node": "20.x",
        "@types/vscode": "^1.100.0",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "@typescript-eslint/parser": "^8.31.1",
        "eslint": "^9.25.1",
        "tsx": "^4.21.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1",
        "lodash": "^4.17.21",
        "minimatch": "^10.1.1",
        "zip-lib": "^1.1.2"
    }
}
