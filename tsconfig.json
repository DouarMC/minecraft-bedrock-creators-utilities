{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "outDir": "./out",
        "lib": ["ES2022"],
        "sourceMap": true,
        "strict": true,
        "types": ["vscode", "node"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*",
        "common/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out",
        "assets",
        "minecraftSchemas",
        "scripts"
    ]
}